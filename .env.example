# Shopify Admin API (custom app on lindas-electric-quilters.myshopify.com)
# Scopes needed: read_products, read_inventory, read_orders, read_reports, read_locations,
#                write_products (only if you enable --apply for pre-order / tag / price actions)
SHOPIFY_SHOP=lindas-electric-quilters.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxx
SHOPIFY_API_VERSION=2025-07

# Klaviyo private API key (read flows/campaigns/metrics)
KLAVIYO_API_KEY=pk_xxx

# Where reports and alerts go. Any of these may be blank.
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=jonathan@lindas.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Local state (SQLite) for daily snapshots, alert de-duplication and history
LINDAS_AGENT_DB=./state/lindas_agent.sqlite
